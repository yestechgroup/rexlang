    },
    {
      "requiring": "esct_calculation",
      "required": "esct_rate"
    },
    {
      "requiring": "esct_calculation",
      "required": "calculate_contributions"
    }
  ],
  "knowledgeRequirements": [
    {
      "requiring": "esct_calculation",
      "required": "calculate_esct"
    }
  ],
  "authorityRequirements": [
    {
      "requiring": "contribution_eligibility",
      "required": "KiwiSaverAct"
    },
    {
      "requiring": "calculate_contributions",
      "required": "KiwiSaverAct"
    },
    {
      "requiring": "esct_calculation",
      "required": "IncomeTaxAct"
    }
  ],
  "services": [
    {
      "name": "AssessContributions",
      "description": "The payroll-facing contract: assess one employee's contributions\nfor a pay run.",
      "inputs": [
        "age",
        "member",
        "employee_rate",
        "other_super_fund",
        "gross_salary",
        "savings_suspension",
        "new_employee",
        "esct_rate",
        "employer_rss_contribution"
      ],
      "outputs": [
        "calculate_contributions",
        "esct_calculation"
      ],
      "encapsulates": [
        "contribution_eligibility",
        "calculate_contributions",
        "esct_calculation",
        "calculate_esct"
      ]
    }
  ],
  "views": [
