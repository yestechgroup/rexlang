        "value": "int"
      }
    }
  ],
  "knowledgeSources": [
    {
      "name": "KiwiSaverAct",
      "displayName": "KiwiSaver Act 2006",
      "reference": "https://www.legislation.govt.nz/act/kiwisaver2006"
    },
    {
      "name": "IncomeTaxAct",
      "displayName": "Income Tax Act 2007",
      "reference": "https://www.legislation.govt.nz/act/incometax2007"
    }
  ],
  "businessKnowledgeModels": [
    {
      "name": "calculate_esct",
      "description": "Employer superannuation contribution tax: the tax on the\nemployer's contribution at the given rate.",
      "parameters": [
        {
          "name": "employer_contribution",
          "typeRef": {
            "type": "primitive",
            "value": "int"
          }
        },
        {
          "name": "rate",
          "typeRef": {
            "type": "primitive",
            "value": "int"
          }
        }
      ],
      "output": {
        "type": "primitive",
        "value": "int"
      },
      "logic": {
        "type": "expression",
        "value": {
          "text": "employer_contribution * rate / 100"
        }
      }
    }
  ],
  "decisions": [
    {
      "name": "contribution_eligibility",
      "description": "Whether the employee's KiwiSaver deduction is compulsory.",
      "outputs": [
        {
          "name": "",
          "typeRef": {
            "type": "enum",
            "value": {
              "package": "nz.payroll",
              "name": "EmployeeDeductionRequired"
            }
          }
        }
      ],
      "logic": {
        "type": "table",
        "value": {
          "source": "./tables/eligibility.md"
        }
      }
    },
    {
      "name": "calculate_contributions",
      "description": "The pay-run contribution picture: the employee deduction, the\nemployer's compulsory contribution, the ESCT on it, and the\ncompliance status the pay run records.",
      "outputs": [
        {
          "name": "employee_deduction_required",
          "typeRef": {
            "type": "enum",
            "value": {
              "package": "nz.payroll",
              "name": "EmployeeDeductionRequired"
            }
          }
        },
        {
          "name": "employer_cec_amount",
          "typeRef": {
            "type": "primitive",
            "value": "int"
          }
        },
        {
          "name": "esct_amount",
          "typeRef": {
            "type": "primitive",
            "value": "int"
          }
        },
        {
          "name": "compliance_status",
          "typeRef": {
            "type": "enum",
            "value": {
              "package": "nz.payroll",
              "name": "ComplianceStatus"
            }
          }
        }
      ],
      "logic": {
        "type": "table",
        "value": {
          "source": "./tables/contributions.md"
        }
      },
      "emits": [
        {
          "event": "ContributionRecorded",
          "when": "compliance_status = \"compliant\""
        },
        {
          "event": "VoluntaryContribution"
        }
      ]
    },
    {
      "name": "esct_calculation",
      "description": "The ESCT owed on the employer's contribution, at the member's\nESCT rate.",
      "outputs": [
        {
          "name": "",
          "typeRef": {
            "type": "primitive",
            "value": "int"
          }
        }
      ],
      "logic": {
        "type": "invoke",
        "value": {
          "model": "calculate_esct",
          "bindings": [
            {
              "name": "employer_contribution",
              "expression": "employer_cec_amount"
            },
            {
              "name": "rate",
              "expression": "esct_rate"
            }
          ]
        }
      }
    }
  ],
  "informationRequirements": [
    {
      "requiring": "contribution_eligibility",
      "required": "age"
    },
    {
      "requiring": "contribution_eligibility",
      "required": "member"
    },
