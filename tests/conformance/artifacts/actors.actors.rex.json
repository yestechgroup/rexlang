              "when": "amount <= 1000",
              "obligations": [
                "audit"
              ]
            }
          ]
        },
        {
          "actor": "Manager",
          "entries": [
            {
              "effect": "permit",
              "capability": "ReadTicket"
            },
            {
              "effect": "permit",
              "capability": "ResolveTicket"
            }
          ]
        },
        {
          "actor": "Finance",
          "entries": [
            {
              "effect": "permit",
              "capability": "ApproveRefund"
            }
          ]
        }
      ],
      "delegations": [
        {
          "name": "RefundIntake",
          "from": "Customer",
          "to": "Agent",
          "purpose": "RefundTriage",
          "entries": [
            {
              "effect": "permit",
              "capability": "ReadTicket",
              "when": "!internal",
              "obligations": [
                "ack"
              ]
            }
          ]
        }
      ],
      "neverBoth": [
        {
          "capabilities": [
            "RaiseRefund",
            "ApproveRefund"
          ]
        }
      ]
