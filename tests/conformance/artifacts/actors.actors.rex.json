          ]
        },
        {
          "name": "SupportHelp",
          "from": "Finance",
          "to": "Agent",
          "purpose": "RefundTriage",
          "entries": [
            {
              "effect": "permit",
              "capability": "ReadTicket"
            }
          ]
        }
      ]
    },
    {
      "name": "Support",
      "actors": [
        {
          "name": "Customer"
        },
        {
          "name": "Agent",
          "extends": "Customer",
          "kind": "agent"
        },
        {
          "name": "Manager",
          "extends": "Agent"
        },
        {
          "name": "Finance"
        }
      ],
      "capabilities": [
        {
          "name": "ReadTicket",
          "class": {
            "type": "class",
            "value": {
              "package": "rex.conformance.actors",
              "name": "Ticket"
            }
          }
        },
        {
          "name": "ResolveTicket",
          "class": {
            "type": "class",
            "value": {
              "package": "rex.conformance.actors",
              "name": "Ticket"
            }
          }
        },
        {
          "name": "RaiseRefund",
          "class": {
            "type": "class",
            "value": {
              "package": "rex.conformance.actors",
              "name": "Ticket"
            }
          }
        },
        {
          "name": "ApproveRefund",
          "class": {
            "type": "class",
            "value": {
              "package": "rex.conformance.actors",
              "name": "Ticket"
            }
          }
        }
      ],
      "purposes": [
        "RefundTriage"
      ],
      "grants": [
        {
          "actor": "Customer",
          "entries": [
            {
              "effect": "permit",
              "capability": "ReadTicket"
            }
          ]
        },
        {
          "actor": "Agent",
          "entries": [
