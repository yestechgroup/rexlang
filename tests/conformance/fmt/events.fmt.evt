// Event contracts for the sample order flow.
event OrderPlaced version "1.0.0" {
    orderId: String;
    total: int;
    owner order_team;
    classification confidential;
    retention "7y";
    pii [ orderId ];
    cloudEvents {
        type "com.example.orderplaced.v1"
        source "/orders"
        subject "{orderId}"
    }
}

event AccountTradeUpdate {
    accountId: String;
}

event OrderCancelled {}

channel orders {
    publishes OrderPlaced;
    publishes OrderCancelled;
}

channel accountTrades of accounts {
    publishes AccountTradeUpdate;
}

subscription billing {
    events [ OrderPlaced OrderCancelled ]
    consumer billing_service
}

subscription account_feed {
    events [ AccountTradeUpdate ]
    consumer trader_ui scope accounts
    when (accountId  !=  "")
    delivery {
        mode at_least_once;
        timeoutSeconds 30;
        deadLetter orders;
    }
}
