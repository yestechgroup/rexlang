import "actors.mox"

actors Escalation {
    actor Finance
    agent Helper extends Finance
    capability EscalateTicket on Ticket
    capability ReadTicket on Ticket
    obligation audit

    grant Finance {
        permit human EscalateTicket when (amount > 0)
    }

    delegation EscalateHelp {
        from Finance
        to Helper
        permit agent EscalateTicket
    }

    delegation SupportHelp {
        from Finance
        to Agent
        purpose RefundTriage
        permit ReadTicket obligation audit
    }
}
