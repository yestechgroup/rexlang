package nz.example.payroll

enum PayRunStatus {
    Draft as "D" = 0
    Approved as "A" = 1
    Posted as "P" = 2
}

class PayRun {
    String id
    PayRunStatus status
    int total
    contains PayRunLine[] lines opposite payRun
}

class PayRunLine {
    container PayRun payRun opposite lines
    String description
    int quantity
    int unitCost
}

class PayRunLineDraft {
    String description
    int quantity
    int unitCost
}

class PayRunAudit {
    String note
}

class AuditEntry {
    boolean accepted
}
