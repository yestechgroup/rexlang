// rexlang reference pattern library — workflow.
// Task-flow patterns: wizards, work queues with bulk assignment, approval
// queues, and progress indicators.

module "Wizard" {
    input { steps: String, entity: Item }
    output { completed: Boolean }

    container "wizard" {
        xor: true;
        if steps != "";

        container "stepOne" {
            default: true;

            component "entry" {
                type: form;
                data: Item;

                on next(values) if values.name != "" -> navigate("stepTwo", { draft: values });
                on cancel -> stay;
            }
        }

        container "stepTwo" {
            component "review" {
                type: details;
                data: Item;

                on previous -> navigate("stepOne");
                on next -> navigate("stepThree");
            }
        }

        container "stepThree" {
            component "confirm" {
                type: details;
                data: Item;

                on previous -> navigate("stepTwo");
                on confirm -> action("CompleteWizard");
            }
        }
    }
}

module "WorkQueue" {
    input { queue: Item, fields: String = "name", assignAction: String = "Assign" }
    output { assigned: Boolean }

    component "backlog" {
        type: table;
        data: Item;
        paginated: true;
        fields: [name, status, assignee];

        column "Name"   -> field Item.name;
        column "Status" -> field Item.status;

        on select(row) -> navigate("WorkItem", { id: row.id });
        on assign(rows) -> action("Assign");
    }
}

module "ApprovalQueue" {
    input { queue: Item, fields: String = "name", assignAction: String = "Assign" }
    output { approved: Boolean }

    use "WorkQueue" as queue {
        queue: Item;
        fields: "name, status";
        assignAction: "Assign";
    };

    component "decision" {
        type: form;

        on approve(row) -> action("Approve");
        on reject(row) -> action("Reject");
    }
}

module "Progress" {
    input { value: Int = 0, max: Int = 100 }
    output { value: Int }

    component "bar" {
        type: chart;
        chart metric { label: progress; values: [value]; }
    }
}
